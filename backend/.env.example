# Copy this file to .env and replace the placeholder values.
INDEXER_URL=https://<confirmed-indexer-ip-or-hostname>:9200
INDEXER_USERNAME=your-indexer-username
INDEXER_PASSWORD=your-indexer-password

# Prefer the Wazuh Indexer CA certificate path when available.
# Example: INDEXER_CA_CERT=/path/to/root-ca.pem
INDEXER_CA_CERT=
INDEXER_VERIFY=true

# Local Ollama only; no API key is required.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120
